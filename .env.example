# Copy to .env for local development only. On a real deployment use environment variables or
# Streamlit secrets (.streamlit/secrets.toml) instead. Values with spaces or # must be quoted.

APP_ENV=development            # development | demo | production
# CARECIRCLE_DB=/var/lib/carecircle/carecircle.db   # required in production, on a persistent disk
# DATA_KEY=                    # required in production: python manage.py generate-key

# Email (Gmail SMTP): create a 16-character App Password in your Google Account
SMTP_USER=yourname@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx

# Optional AI assistant
GEMINI_API_KEY=
# GEMINI_PAID_TIER=true        # required for the AI assistant in production

# SCHEDULER_MODE=thread        # thread | external (run python worker.py) | off
# MFA_ROLES=caretaker          # roles that must enter an emailed code (default: caretaker in production)
# EMERGENCY_NUMBER=112
