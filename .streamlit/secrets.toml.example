# Paste into Streamlit Community Cloud: app Settings > Secrets. Never commit a real secrets.toml.
#
# Community Cloud has no persistent disk, so the SQLite database is wiped on every reboot or redeploy.
# Use it for the DEMO only. For real families, deploy on a host with a persistent volume (docs/DEPLOYMENT.md);
# production mode refuses to start on Community Cloud.

APP_ENV = "demo"
DATA_KEY = "paste the output of: python manage.py generate-key"

SMTP_USER = "reminders@yourdomain.example"
SMTP_PASS = "app password"
# SMTP_HOST = "smtp.gmail.com"
# SMTP_PORT = "465"
# SMTP_SECURITY = "ssl"         # ssl | starttls | none

# GEMINI_API_KEY = ""

SCHEDULER_MODE = "thread"       # Community Cloud runs one process, so reminders run inside the app
APP_TZ = "Asia/Kolkata"
EMERGENCY_NUMBER = "112"
